<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create Note</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-slate-100">
  <%- include("partials/nav") %>
  <%- include("partials/alerts") %>

  <main class="px-4 py-10">
    <div class="mx-auto max-w-5xl">
      <div class="mx-auto max-w-2xl">
        <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-200/60">
          
          <div class="border-b border-slate-200 bg-gradient-to-r from-blue-600 to-indigo-600 px-8 py-8 text-white">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="mb-2 text-sm font-medium text-blue-100">Notes Management</p>
                <h1 class="text-3xl font-bold tracking-tight">Create a New Notes</h1>
                <p class="mt-2 text-sm text-blue-100">
                  Write down your thoughts, tasks, ideas, or important reminders.
                </p>
              </div>

              <a
                href="/notes/dashboard"
                class="inline-flex items-center rounded-xl bg-white/15 px-4 py-2 text-sm font-medium text-white backdrop-blur transition hover:bg-white/25"
              >
                Back
              </a>
            </div>
          </div>

          <div class="p-8 sm:p-10">
            <form action="/notes/create" method="POST" class="space-y-6">
              
              <div>
                <label for="title" class="mb-2 block text-sm font-semibold text-slate-700">
                  Notes Title
                </label>
                <input
                  id="title"
                  type="text"
                  name="title"
                  required
                  maxlength="120"
                  placeholder="Enter your note title"
                  value="<%= title || '' %>"
                  class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-800 placeholder:text-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
                />
                <p class="mt-2 text-xs text-slate-500">Keep it short and clear.</p>
              </div>

              <div>
                <label for="content" class="mb-2 block text-sm font-semibold text-slate-700">
                  Notes Content
                </label>
                <textarea
                  id="content"
                  name="content"
                  rows="8"
                  maxlength="5000"
                  placeholder="Write your note here..."
                  class="w-full resize-none rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-800 placeholder:text-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
                ><%= content || '' %></textarea>
                <p class="mt-2 text-xs text-slate-500">
                  Add details, reminders, or anything important you want to save.
                </p>
              </div>

              <div class="flex flex-col gap-3 pt-2 sm:flex-row">
                <button
                  type="submit"
                  class="inline-flex w-full items-center justify-center rounded-2xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-md shadow-blue-200 transition hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-100 sm:w-auto"
                >
                  Add Notes
                </button>

                <a
                  href="/notes/dashboard"
                  class="inline-flex w-full items-center justify-center rounded-2xl border border-slate-300 bg-white px-6 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 sm:w-auto"
                >
                  Cancel
                </a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>