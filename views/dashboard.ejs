<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-slate-100">
    <%- include("partials/nav") %>
    <%- include("partials/alerts") %>

    <main class="px-4 py-8 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-6xl">
        <div class="mb-8 flex flex-col gap-4 rounded-3xl bg-gradient-to-r from-blue-600 to-indigo-600 p-6 text-white shadow-xl shadow-blue-200/60 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p class="text-sm font-medium text-blue-100">Notes Management</p>
            <h1 class="mt-1 text-3xl font-bold tracking-tight">Your Notes Dashboard</h1>
            <p class="mt-2 text-sm text-blue-100">
              Organize, search, and manage all your notes in one place.
            </p>
          </div>

          <a
            href="/notes/create"
            class="inline-flex items-center justify-center rounded-2xl bg-white px-5 py-3 text-sm font-semibold text-blue-700 shadow-md transition hover:bg-blue-50"
          >
            + Create Notes
          </a>
        </div>

        <section class="mb-6 rounded-3xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-200/50">
          <div class="mb-5">
            <h2 class="text-lg font-semibold text-slate-800">Search & Filter Notes</h2>
            <p class="mt-1 text-sm text-slate-500">
              Quickly find notes by title, content, date, or sorting preference.
            </p>
          </div>

          <form method="GET" action="/notes/dashboard" class="grid grid-cols-1 gap-4 md:grid-cols-5">
            <div class="md:col-span-2">
              <label class="mb-2 block text-sm font-medium text-slate-700" for="q">Search</label>
              <input
                id="q"
                type="text"
                name="q"
                value="<%= query.q || '' %>"
                placeholder="Search by title or content"
                class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-800 placeholder:text-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
              />
            </div>

            <div>
              <label class="mb-2 block text-sm font-medium text-slate-700" for="from">From</label>
              <input
                id="from"
                type="date"
                name="from"
                value="<%= query.from || '' %>"
                class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-800 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
              />
            </div>

            <div>
              <label class="mb-2 block text-sm font-medium text-slate-700" for="to">To</label>
              <input
                id="to"
                type="date"
                name="to"
                value="<%= query.to || '' %>"
                class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-800 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
              />
            </div>

            <div>
              <label class="mb-2 block text-sm font-medium text-slate-700" for="sort">Sort</label>
              <select
                id="sort"
                name="sort"
                class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-800 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
              >
                <option value="latest" <%= (query.sort === 'latest' || !query.sort) ? 'selected' : '' %>>Latest</option>
                <option value="oldest" <%= query.sort === 'oldest' ? 'selected' : '' %>>Oldest</option>
              </select>
            </div>

            <div class="md:col-span-5 flex flex-wrap items-center gap-3 pt-2">
              <button
                class="inline-flex items-center justify-center rounded-2xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white shadow-md shadow-blue-200 transition hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-100"
                type="submit"
              >
                Apply Filters
              </button>

              <a
                href="/notes/dashboard"
                class="inline-flex items-center justify-center rounded-2xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-slate-50"
              >
                Reset
              </a>
            </div>
          </form>
        </section>

        <section class="rounded-3xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-200/50">
          <div class="mb-5 flex flex-col gap-3 border-b border-slate-200 pb-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="text-lg font-semibold text-slate-800">All Notes</h2>
              <p class="mt-1 text-sm text-slate-500">
                Showing <span class="font-semibold text-slate-700"><%= notes.length %></span>
                of
                <span class="font-semibold text-slate-700"><%= total %></span> notes
              </p>
            </div>
          </div>

          <% if (!notes || notes.length === 0) { %>
            <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center">
              <div class="mx-auto max-w-md">
                <h3 class="text-lg font-semibold text-slate-700">No notes found</h3>
                <p class="mt-2 text-sm text-slate-500">
                  Try changing your search filters or create a new note to get started.
                </p>
                <a
                  href="/notes/create"
                  class="mt-5 inline-flex items-center justify-center rounded-2xl bg-blue-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-blue-700"
                >
                  Create Your First Notes
                </a>
              </div>
            </div>
          <% } else { %>
            <div class="grid gap-4">
              <% notes.forEach(function(note){ %>
                <article class="group rounded-2xl border border-slate-200 bg-slate-50 p-5 transition hover:-translate-y-0.5 hover:border-blue-200 hover:bg-white hover:shadow-lg hover:shadow-slate-200/60">
                  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-3">
                        <h3 class="text-xl font-semibold text-slate-800 break-words">
                          <%= note.title %>
                        </h3>
                        <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-medium text-blue-700">
                          Note
                        </span>
                      </div>

                      <p class="mt-2 text-sm text-slate-500">
                        Created on <%= new Date(note.createdAt).toLocaleString() %>
                      </p>

                      <p class="mt-4 text-sm leading-6 text-slate-600">
                        <%= 
                          (note.content || '').length > 180
                            ? (note.content || '').substring(0, 180) + '...'
                            : (note.content || '')
                        %>
                      </p>
                    </div>

                    <div class="flex shrink-0 gap-2 sm:flex-col">
                      <a
                        href="/notes/edit/<%= note._id %>"
                        class="inline-flex items-center justify-center rounded-xl border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-semibold text-blue-700 transition hover:bg-blue-100"
                      >
                        Edit
                      </a>

                      <form action="/notes/delete/<%= note._id %>" method="POST">
                        <button
                          type="submit"
                          class="inline-flex items-center justify-center rounded-xl border border-red-200 bg-red-50 px-4 py-2 text-sm font-semibold text-red-700 transition hover:bg-red-100"
                          onclick="return confirm('Delete this note?');"
                        >
                          Delete
                        </button>
                      </form>
                    </div>
                  </div>
                </article>
              <% }) %>
            </div>
          <% } %>

          <% if (totalPages > 1) { %>
            <div class="mt-8 flex flex-wrap items-center justify-center gap-2 border-t border-slate-200 pt-6">
              <%
                function makeLink(p) {
                  const params = new URLSearchParams();
                  if (query.q) params.set('q', query.q);
                  if (query.from) params.set('from', query.from);
                  if (query.to) params.set('to', query.to);
                  params.set('sort', query.sort || 'latest');
                  params.set('page', p);
                  params.set('limit', String(limit || 10));
                  return '/notes/dashboard?' + params.toString();
                }
              %>

              <% if (page > 1) { %>
                <a
                  class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50"
                  href="<%= makeLink(page - 1) %>"
                >
                  Prev
                </a>
              <% } %>

              <% for (let p = 1; p <= totalPages; p++) { %>
                <% if (p === page) { %>
                  <span class="rounded-xl bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-md shadow-blue-200">
                    <%= p %>
                  </span>
                <% } else { %>
                  <a
                    class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50"
                    href="<%= makeLink(p) %>"
                  >
                    <%= p %>
                  </a>
                <% } %>
              <% } %>

              <% if (page < totalPages) { %>
                <a
                  class="rounded-xl border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-50"
                  href="<%= makeLink(page + 1) %>"
                >
                  Next
                </a>
              <% } %>
            </div>
          <% } %>
        </section>
      </div>
    </main>
  </body>
</html>