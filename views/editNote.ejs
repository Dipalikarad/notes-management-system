<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Note</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-slate-100">
    <%- include("partials/nav") %>
    <%- include("partials/alerts") %>

    <main class="px-4 py-8 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-4xl">
        <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-200/60">
          
          <div class="bg-gradient-to-r from-blue-600 via-indigo-600 to-slate-800 px-8 py-10 text-white">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-sm font-medium uppercase tracking-[0.2em] text-blue-100">
                  Notes Workspace
                </p>
                <h1 class="mt-2 text-3xl font-bold tracking-tight">Edit Note</h1>
                <p class="mt-2 text-sm text-blue-100">
                  Update your note details and keep your information organized.
                </p>
              </div>

              <a
                href="/notes/dashboard"
                class="inline-flex items-center justify-center rounded-2xl bg-white px-5 py-3 text-sm font-semibold text-blue-700 shadow-md transition hover:bg-blue-50"
              >
                Back
              </a>
            </div>
          </div>

          <div class="p-8 sm:p-10">
            <form action="/notes/edit/<%= note._id %>" method="POST" class="space-y-6">
              <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" for="title">
                  Title
                </label>
                <input
                  id="title"
                  type="text"
                  name="title"
                  required
                  maxlength="120"
                  value="<%= note.title %>"
                  placeholder="Enter note title"
                  class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-800 placeholder:text-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
                />
              </div>

              <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" for="content">
                  Content
                </label>
                <textarea
                  id="content"
                  name="content"
                  rows="8"
                  maxlength="5000"
                  placeholder="Update your note content..."
                  class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-800 placeholder:text-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
                ><%= note.content || '' %></textarea>
              </div>

              <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-4">
                <p class="text-sm text-slate-600">
                  Make sure your note title is clear and your content is updated before saving changes.
                </p>
              </div>

              <button
                type="submit"
                class="inline-flex w-full items-center justify-center rounded-2xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-md shadow-blue-200 transition hover:bg-blue-700"
              >
                Update Note
              </button>
            </form>
          </div>

        </div>
      </div>
    </main>
  </body>
</html>