<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Password</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="min-h-screen bg-slate-100">
    <%- include("partials/nav") %>
    <%- include("partials/alerts") %>

    <main class="px-4 py-8 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl">
        <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-200/60">
          
          <div class="bg-gradient-to-r from-blue-600 via-indigo-600 to-slate-800 px-8 py-10 text-white">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-sm font-medium uppercase tracking-[0.2em] text-blue-100">
                  Security Settings
                </p>
                <h1 class="mt-2 text-3xl font-bold tracking-tight">Change Password</h1>
                <p class="mt-2 text-sm text-blue-100">
                  Update your password to keep your account safe and secure.
                </p>
              </div>

              <a
                href="/profile"
                class="inline-flex items-center justify-center rounded-2xl bg-white px-5 py-3 text-sm font-semibold text-blue-700 shadow-md transition hover:bg-blue-50"
              >
                Back
              </a>
            </div>
          </div>

          <div class="p-8 sm:p-10">
            <form action="/profile/change-password" method="POST" class="space-y-6">
              <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" for="currentPassword">
                  Current Password
                </label>
                <input
                  id="currentPassword"
                  type="password"
                  name="currentPassword"
                  required
                  placeholder="Enter your current password"
                  class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-800 placeholder:text-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
                />
              </div>

              <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" for="newPassword">
                  New Password
                </label>
                <input
                  id="newPassword"
                  type="password"
                  name="newPassword"
                  required
                  minlength="8"
                  placeholder="Enter your new password"
                  class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-800 placeholder:text-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
                />
              </div>

              <div>
                <label class="mb-2 block text-sm font-semibold text-slate-700" for="confirmPassword">
                  Confirm New Password
                </label>
                <input
                  id="confirmPassword"
                  type="password"
                  name="confirmPassword"
                  required
                  minlength="8"
                  placeholder="Re-enter your new password"
                  class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-800 placeholder:text-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
                />
              </div>

              <div class="rounded-2xl border border-dashed border-slate-300 bg-slate-50 p-4">
                <p class="text-sm text-slate-600">
                  Use a strong password with at least 8 characters for better account protection.
                </p>
              </div>

              <button
                class="inline-flex w-full items-center justify-center rounded-2xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-md shadow-blue-200 transition hover:bg-blue-700"
                type="submit"
              >
                Update Password
              </button>
            </form>
          </div>

        </div>
      </div>
    </main>
  </body>
</html>