<% if (success && success.length) { %>
  <div class="max-w-5xl mx-auto px-4 mt-4">
    <% success.forEach(function(msg){ %>
      <div class="bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded mb-3">
        <%= msg %>
      </div>
    <% }) %>
  </div>
<% } %>

<% if (error && error.length) { %>
  <div class="max-w-5xl mx-auto px-4 mt-4">
    <% error.forEach(function(msg){ %>
      <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded mb-3">
        <%= msg %>
      </div>
    <% }) %>
  </div>
<% } %>

