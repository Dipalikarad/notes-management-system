<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include("partials/head", { title: "Login" }) %>
  </head>
  <body class="min-h-screen bg-slate-100">
    <%- include("partials/nav") %>
    <%- include("partials/alerts") %>

    <main class="flex min-h-[calc(100vh-80px)] items-center justify-center px-4 py-10">
      <div class="w-full max-w-5xl overflow-hidden rounded-3xl bg-white shadow-2xl shadow-slate-200/70">
        <div class="grid min-h-[600px] lg:grid-cols-2">
          
          <div class="hidden lg:flex flex-col justify-between bg-gradient-to-br from-blue-600 via-indigo-600 to-slate-800 p-10 text-white">
            <div>
              <p class="text-sm font-medium uppercase tracking-[0.2em] text-blue-100">
                Notes Management
              </p>
              <h1 class="mt-4 text-4xl font-bold leading-tight">
                Welcome back to your workspace
              </h1>
              <p class="mt-4 max-w-md text-sm leading-6 text-blue-100">
                Organize your ideas, manage your notes, and stay productive with a clean and secure notes dashboard.
              </p>
            </div>

            <div class="space-y-4">
              <div class="rounded-2xl bg-white/10 p-4 backdrop-blur-sm">
                <p class="text-sm font-semibold">Secure Login</p>
                <p class="mt-1 text-sm text-blue-100">
                  Access your notes safely and continue where you left off.
                </p>
              </div>

              <div class="rounded-2xl bg-white/10 p-4 backdrop-blur-sm">
                <p class="text-sm font-semibold">Fast and Simple</p>
                <p class="mt-1 text-sm text-blue-100">
                  A distraction-free interface built for managing notes efficiently.
                </p>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-center p-6 sm:p-10 lg:p-12">
            <div class="w-full max-w-md">
              <div class="mb-8">
                <h2 class="text-3xl font-bold tracking-tight text-slate-800">Login</h2>
                <p class="mt-2 text-sm text-slate-500">
                  Enter your credentials to access your account.
                </p>
              </div>

              <form action="/login" method="POST" class="space-y-5">
                <div>
                  <label class="mb-2 block text-sm font-semibold text-slate-700" for="email">
                    Email Address
                  </label>
                  <input
                    id="email"
                    type="email"
                    name="email"
                    required
                    placeholder="you@example.com"
                    class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-800 placeholder:text-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
                  />
                </div>

                <div>
                  <label class="mb-2 block text-sm font-semibold text-slate-700" for="password">
                    Password
                  </label>
                  <input
                    id="password"
                    type="password"
                    name="password"
                    required
                    placeholder="Enter your password"
                    class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-800 placeholder:text-slate-400 outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"
                  />
                </div>

                <button
                  type="submit"
                  class="inline-flex w-full items-center justify-center rounded-2xl bg-blue-600 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-200 transition hover:bg-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-100"
                >
                  Login
                </button>
              </form>

              <p class="mt-6 text-center text-sm text-slate-600">
                Don&apos;t have an account?
                <a href="/register" class="font-semibold text-blue-600 transition hover:text-blue-700 hover:underline">
                  Create account
                </a>
              </p>
            </div>
          </div>

        </div>
      </div>
    </main>
  </body>
</html>